#!/usr/bin/env bash
#MISE description="Compile all workspace modules (or those owning the given files)"
set -euo pipefail
# -o /dev/null: compile only; a module with a single main package would
# otherwise write its binary into the working tree.
mods="$(scripts/go-modules.sh "$@")" # separate assignment so set -e sees a failure
for m in $mods; do (cd "$m" && go build -o /dev/null ./...); done
