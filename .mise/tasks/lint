#!/usr/bin/env bash
#MISE description="Run golangci-lint on all workspace modules (or those owning the given files)"
set -euo pipefail
status=0
mods="$(scripts/go-modules.sh "$@")" # separate assignment so set -e sees a failure
for m in $mods; do
	echo "lint $m"
	(cd "$m" && golangci-lint run ./...) || status=1
done
exit "$status"
