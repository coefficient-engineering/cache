#!/usr/bin/env bash
#MISE description="Run Redis L2 integration tests against a disposable three-primary Cluster; extra args go to go test"
set -euo pipefail

root="$(cd "$(dirname "${BASH_SOURCE[0]}")/../../.." && pwd)"
container=""
cleanup() {
  status=$?
  if [[ -n "$container" ]]; then
    if [[ "$status" -ne 0 ]]; then
      docker logs "$container" >&2 || true
    fi
    docker rm -f "$container" >/dev/null 2>&1 || true
  fi
  return "$status"
}
trap cleanup EXIT
trap 'exit 130' INT
trap 'exit 143' TERM

# Random loopback host ports avoid collisions between concurrent runs. All three
# servers share one network namespace, so their advertised loopback addresses
# remain reachable to one another; the Go dialer translates them for the host.
container="$(docker run -d --rm \
  -p 127.0.0.1::7000 -p 127.0.0.1::7001 -p 127.0.0.1::7002 \
  redis:7-alpine sh -ec '
    for port in 7000 7001 7002; do
      mkdir -p "/tmp/redis-$port"
      redis-server --port "$port" --bind 0.0.0.0 --protected-mode no \
        --cluster-enabled yes --cluster-config-file nodes.conf \
        --cluster-node-timeout 5000 --cluster-announce-ip 127.0.0.1 \
        --cluster-announce-port "$port" --cluster-announce-bus-port "$((port + 10000))" \
        --dir "/tmp/redis-$port" --appendonly no --save "" &
    done
    wait
  ')"

for port in 7000 7001 7002; do
  ready=false
  for ((attempt = 0; attempt < 100; attempt++)); do
    if [[ "$(docker exec "$container" redis-cli -p "$port" ping 2>/dev/null | tr -d '\r')" == PONG ]]; then
      ready=true
      break
    fi
    sleep 0.1
  done
  if [[ "$ready" != true ]]; then
    docker logs "$container" >&2
    echo "Redis on port $port did not become ready" >&2
    exit 1
  fi
done

docker exec "$container" redis-cli --cluster create \
  127.0.0.1:7000 127.0.0.1:7001 127.0.0.1:7002 \
  --cluster-replicas 0 --cluster-yes

for port in 7000 7001 7002; do
  ready=false
  for ((attempt = 0; attempt < 100; attempt++)); do
    info="$(docker exec "$container" redis-cli -p "$port" cluster info | tr -d '\r')"
    if grep -qx 'cluster_state:ok' <<< "$info" && grep -qx 'cluster_slots_assigned:16384' <<< "$info"; then
      ready=true
      break
    fi
    sleep 0.1
  done
  if [[ "$ready" != true ]]; then
    docker logs "$container" >&2
    echo "Redis Cluster did not become healthy on port $port" >&2
    exit 1
  fi
done

addr0="$(docker port "$container" 7000/tcp)"
addr1="$(docker port "$container" 7001/tcp)"
addr2="$(docker port "$container" 7002/tcp)"
export REDIS_CLUSTER_ADDRS="$addr0,$addr1,$addr2"
export REDIS_CLUSTER_DIAL_MAP="{\"127.0.0.1:7000\":\"$addr0\",\"127.0.0.1:7001\":\"$addr1\",\"127.0.0.1:7002\":\"$addr2\"}"
cd "$root/adapters/l2/redis"
go test -tags=integration -count=1 "$@" ./...
